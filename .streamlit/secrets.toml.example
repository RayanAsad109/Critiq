# Copy this file to .streamlit/secrets.toml (which is git-ignored) and fill it in.
# On Streamlit Community Cloud, paste the same contents into App settings → Secrets.

TMDB_API_KEY = "your-tmdb-v3-key-or-v4-read-token"

# IMDb + Rotten Tomatoes scores (free, 1,000 lookups/day): https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY = "your-omdb-key"

# Hosted Postgres (e.g. Neon). Leave this out to use a local SQLite file instead.
DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"

# "Sign in with Google". Leave this whole section out to run in single-user local mode.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # deployed: https://<your-app>.streamlit.app/oauth2callback
cookie_secret = "any-long-random-string"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
